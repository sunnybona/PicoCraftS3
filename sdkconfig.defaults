# ===== Target chip =====
CONFIG_IDF_TARGET="esp32s3"

# ===== Flash (16 MB, DIO, 80 MHz) =====
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ===== Partition table: single app =====
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# ===== PSRAM: octal ESP-PSRAM64, 80 MHz =====
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ===== CPU: 160 MHz (same as the verified LCD project) =====
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_160=y

# ===== Compiler: optimize for size/performance balance =====
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ===== FreeRTOS =====
CONFIG_FREERTOS_HZ=1000

# ===== Main task: generous stack for game logic + mesh + NVS save path =====
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
